DATABASE_URL=postgresql+psycopg://collabspace:collabspace@localhost:5432/collabspace
SQL_ECHO=false

# Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Realtime fan-out between backend instances. Leave empty for single-instance, in-memory only.
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call the API directly, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Logging: level and format (json, or text for readable local output).
LOG_LEVEL=INFO
LOG_FORMAT=text

# Database connection pool, per backend worker process. Worst case is
# workers x (size + overflow) connections; keep it under Postgres's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds to wait for a free connection before failing with a 503.
DB_POOL_TIMEOUT=10
# Seconds before a connection is replaced, ahead of any proxy idle timeout.
DB_POOL_RECYCLE=1800
