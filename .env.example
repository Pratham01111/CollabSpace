# Copy to .env, then: docker compose up --build
# Compose reads this file automatically. Never commit the real .env.

# ---- PostgreSQL ----
POSTGRES_USER=collabspace
POSTGRES_PASSWORD=collabspace
POSTGRES_DB=collabspace

# ---- Auth ----
# Signs every access token. CHANGE THIS for anything beyond local use:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-only-change-me-0123456789abcdefghijklmnop
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Ports published on your machine ----
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Optional ----
# Database connection pool, per backend worker process. Worst case is
# workers x (size + overflow) connections; keep it under Postgres's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seconds to wait for a free connection before failing with a 503.
DB_POOL_TIMEOUT=10
# Seconds before a connection is replaced, ahead of any proxy idle timeout.
DB_POOL_RECYCLE=1800
# Logging: one JSON object per line (json), or readable lines (text).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Backend worker processes (they share realtime state through Redis).
BACKEND_WORKERS=2
# Show "Continue as guest" on the login page of the built frontend.
VITE_ENABLE_GUEST=false
# Only needed if a browser calls the backend directly instead of via the
# frontend's /api proxy (e.g. the Vite dev server), comma-separated.
CORS_ORIGINS=
